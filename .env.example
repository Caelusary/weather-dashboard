# Copy to .env.local and add your own OpenWeatherMap key (https://openweathermap.org/api).
# Server-side only: read by api/weather.js (Vercel) and the Vite dev middleware, never bundled.
# Keep the name without a VITE_ prefix, or Vite would inline it into the public JS.
OPENWEATHER_API_KEY=your_key_here
